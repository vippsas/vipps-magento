<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="widget_sdk" translate="label comment" showInDefault="1" showInWebsite="1" showInStore="1" sortOrder="65">
        <label>Widget SDK</label>
        <field id="widget_sdk_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Enable Widget SDK</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>payment/vipps/widget_sdk_enabled</config_path>
            <comment>
                <![CDATA[Loads the Vipps MobilePay Widget SDK script on storefront pages where the Express Checkout button can appear (product, cart, and mini-cart pages), excluding checkout. See https://developer.vippsmobilepay.com/docs/buttons-and-widgets/widget/]]>
            </comment>
            <requires>
                <group id="vipps_required"/>
            </requires>
        </field>
    </group>
</include>
