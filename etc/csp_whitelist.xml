<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="vipps_widget_sdk" type="host">cdn.vippsmobilepay.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="vipps_widget_pay" type="host">pay.vipps.no</value>
                <value id="vipps_widget_pay_test" type="host">pay-mt.vipps.no</value>
                <value id="vipps_widget_api" type="host">api.vipps.no</value>
                <value id="vipps_widget_api_test" type="host">apitest.vipps.no</value>
                <value id="vipps_widget_mobilepay_dk" type="host">pay.mobilepay.dk</value>
                <value id="vipps_widget_mobilepay_dk_test" type="host">pay-mt.mobilepay.dk</value>
                <value id="vipps_widget_mobilepay_fi" type="host">pay.mobilepay.fi</value>
                <value id="vipps_widget_mobilepay_fi_test" type="host">pay-mt.mobilepay.fi</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="vipps_widget_designsystem" type="host">designsystem.vippsmobilepay.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
